<Application x:Class="PaceDesktop.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:PaceDesktop.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette (Light default; ThemeService swaps this at runtime) then styles. -->
                <ResourceDictionary Source="Themes/Palette.Light.xaml"/>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:FavoriteWeightConverter x:Key="FavoriteWeightConverter"/>
            <conv:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
