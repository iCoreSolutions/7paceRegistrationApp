<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PaceDesktop.Server</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\7PaceDesktop.Core\7PaceDesktop.Core.csproj" />
    <!-- wwwroot/.gitkeep is a git-tracking placeholder (git does not track empty directories),
         not an app asset. It must not enter the static web assets pipeline: Vite's
         emptyOutDir: true (see vite.config.ts) deletes it from disk the moment PublishSpa below
         runs npm run build, and if the Build-time asset scan already recorded it as something to
         publish, the later copy step fails with MSB3030 (file not found) - verified live. -->
    <Content Remove="wwwroot\.gitkeep" />
  </ItemGroup>

  <!-- Build the SPA and bundle it into the publish output, so the published executable is the
       whole app. Local Build/Debug never needs this: run the Vite dev server instead.

       Hooked on "AfterTargets=ComputeFilesToPublish" - the standard ASP.NET Core pattern for
       folding an external front-end build into "dotnet publish" - rather than "BeforeTargets=
       Build" or "BeforeTargets=Publish", for two reasons proven out while wiring this up:
         1. MSBuild resolves the Tests project's ProjectReference to this project by running
            Server.csproj's own default target (Build), so any hook on "Build" - even guarded by
            Configuration or MSBuildProjectName, both tried and rejected - still fires whenever
            anything that references this project builds in Release (e.g. `dotnet test -c
            Release`, or `dotnet build 7PaceDesktop.slnx -c Release`), forcing Node/npm onto every
            machine that merely builds or tests the solution.
         2. "BeforeTargets=Publish" avoids that, but still runs too late: ASP.NET Core's static
            web assets file list is computed as part of Build, which Publish depends on and which
            completes before a "BeforeTargets=Publish" hook runs - so files written to wwwroot at
            that point are on disk but never make it into the publish output (verified: the
            published wwwroot contained only .gitkeep). Adding the built files to
            ResolvedFileToPublish explicitly, after they are computed, is what actually gets them
            copied.
       "dotnet publish" is never invoked transitively through a plain ProjectReference, so this
       cannot be dragged into an unrelated project's build the way a Build-time hook can. -->
  <Target Name="PublishSpa" AfterTargets="ComputeFilesToPublish">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\web" />

    <ItemGroup>
      <SpaFiles Include="$(MSBuildProjectDirectory)wwwroot\**" />
      <ResolvedFileToPublish Include="@(SpaFiles)">
        <RelativePath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
